.cache/
.cache-*/
.ninja_deps
.ninja_log

# Keep project documentation, Claude guidance, source, tests, and GitHub metadata.
# In particular, do NOT add README.md, LICENSE, CLAUDE.md, CLAUDE_PROMPT.md,
# docs/, .github/, src/, or tests/ to this ignore file.

# Private one-off review handoff (keep out of the public repository)
/SKYFRAME-QUICK-REVIEW.md
